# Copy to .env for local development, then replace every CHANGE_ME placeholder.
# Never commit .env or use these placeholders in a deployed environment.
POSTGRES_DB=memocean
POSTGRES_USER=memocean_bootstrap
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Distinct role logins. Provision roles as described in README.md, then use their credentials here.
DATABASE_URL=postgresql://memocean_request_login:CHANGE_ME@127.0.0.1:5432/memocean
MIGRATION_DATABASE_URL=postgresql://memocean_migration:CHANGE_ME@127.0.0.1:5432/memocean
WORKER_DATABASE_URL=postgresql://memocean_worker_login:CHANGE_ME@127.0.0.1:5432/memocean
ENABLE_WORKER=false

NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
AUTH_DOMAIN=localhost:5173
TOKEN_HASH_PEPPER=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
KEK_V1_BASE64=CHANGE_ME_BASE64_OF_EXACTLY_32_RANDOM_BYTES

# Optional providers. Omit provider keys until explicitly configured.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3.5-lite
EMBEDDING_DIMENSIONS=1024

# Fuji is a test network. No marketplace deployment is configured by this example.
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
CHAIN_CONFIRMATIONS=3
JOB_CONCURRENCY=2
